\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{fiu_thesis}[2026/09/20 FIU-inspired thesis draft layout]

\RequirePackage[left=1.5in,right=1in,top=1in,bottom=1in]{geometry}
\RequirePackage{setspace}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{positioning}
\RequirePackage{float}
\RequirePackage{caption}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{amsmath}
\RequirePackage{siunitx}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage{titlesec}
\RequirePackage{hyperref}

\hypersetup{hidelinks,pdftitle={\ThesisTitle},pdfauthor={\ThesisAuthor}}
\graphicspath{{figures/}}
% Shared figure treatment: equal widths, original image proportions.
\newcommand{\thesisimage}[2][]{%
  \includegraphics[#1,width=0.70\linewidth]{#2}%
}
\captionsetup[figure]{font={small,stretch=1},width=0.80\textwidth,
  justification=centering,skip=8pt}
\doublespacing
\setlength{\parindent}{0.5in}
\setlength{\parskip}{0pt}
% Apply the compact Chapter 1 opening treatment throughout the thesis.
\setlength{\emergencystretch}{3em}
\raggedbottom
\renewcommand{\thesubsection}{\thesection\arabic{subsection}}
\setcounter{tocdepth}{2}
\renewcommand{\contentsname}{TABLE OF CONTENTS}
\renewcommand{\listfigurename}{LIST OF FIGURES}
\renewcommand{\listtablename}{LIST OF TABLES}
\renewcommand{\bibname}{BIBLIOGRAPHY}

% Peer theses use centered chapter labels, a restrained serif face, and
% page numbers at the bottom center. This is an approximation, not an
% official FIU class file.
\titleformat{\chapter}[display]
  {\normalfont\singlespacing\centering}
  {CHAPTER \thechapter}
  {6pt}
  {\bfseries\MakeUppercase}
\titlespacing*{\chapter}{0pt}{-10pt}{8pt}
\titleformat{\section}{\normalfont\Large\bfseries\singlespacing\raggedright}
  {\thesection}{1em}{}
\titlespacing*{\section}{0pt}{12pt}{8pt}
\titleformat{\subsection}{\normalfont\large\bfseries\singlespacing\raggedright}
  {\thesubsection}{1em}{}
\titlespacing*{\subsection}{0pt}{12pt}{8pt}
\pagestyle{plain}

\newcommand{\makethesistitle}{%
  \begin{titlepage}
  \thispagestyle{empty}
  \begin{center}
  \singlespacing
  \ThesisUniversity\\[0.6\baselineskip]
  \ThesisLocation

  \vspace{1.45in}
  \begin{minipage}{0.94\textwidth}
  \centering\fontsize{11}{17}\selectfont\ThesisTitle
  \end{minipage}

  \vspace{1.25in}
  A thesis submitted in partial fulfillment of the\\[0.4\baselineskip]
  requirements for the degree of\\[0.4\baselineskip]
  \ThesisDegree\\[0.4\baselineskip]
  in\\[0.4\baselineskip]
  \ThesisField\\[0.4\baselineskip]
  by\\[0.4\baselineskip]
  \ThesisAuthor

  \vfill
  \ThesisYear
  \end{center}
  \end{titlepage}
}

\newcommand{\draftnote}[1]{\par\noindent\textbf{Drafting note:} #1\par}
